{
  "name": "sailing-buddy",
  "version": "1.0.0",
  "description": "Offline-Helfer für Segler: Funksprüche, Position und Kurs, Lichter- und Schallsignale – als installierbare Web-App ohne Bauschritt.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tools/smoke.mjs",
    "start": "python3 -m http.server 8080",
    "icons": "python3 tools/make-icons.py",
    "build:single": "node tools/build-single-file.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.49.1"
  }
}
